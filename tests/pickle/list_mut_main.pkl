fn main() {
    let xs = [10, 20, 30, 40]
    let removed = xs.remove(1)
    xs.insert(1, 21)
    xs.push(50)
    xs.sort()
    println("main", len(xs), removed, xs[0], xs[3])
    let words = ["pear", "apple"]
    words.sort()
    println("words", words[0], words[1])
    let fs = [2.5, 1.5]
    fs.sort()
    println("fs", fs[0], fs[1])
}