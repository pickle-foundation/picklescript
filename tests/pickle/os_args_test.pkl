test fn os_args_empty_in_test_context() {
    // `pickle test` starts fresh per module; no argv is forwarded, so
    // `args()` is always an empty list under the test runner.
    let a = args()
    expect(len(a)).toBe(0)
    expect(a is List<string>).toBe(true)
}

test fn os_args_is_fresh_list() {
    // Every call returns a new list; mutating one must not affect the other.
    let a = args()
    let b = args()
    a.push("x")
    expect(len(a)).toBe(1)
    expect(len(b)).toBe(0)
}

test fn os_args_elements_are_strings() {
    let a = args()
    for (i in 0..len(a)) {
        expect(a[i] is string).toBe(true)
    }
}