class Pt {
    x: int
    y: int
}

enum Shape {
    Circle
    Square
    Rect(w: int, h: int)
}

fn main() {
    var m = {[1, 2]: "pair", [3, 4]: "other"}
    println("a={m[[1, 2]]} b={m[[3, 4]]}")
    let p = Pt(5, 6)
    var byobj = {p: 10}
    println("obj={byobj[Pt(5, 6)]}")
    var es = {Shape.Circle: "c", Shape.Rect(2, 3): "r"}
    println("c={es[Shape.Circle]} r={es[Shape.Rect(2, 3)]}")
    m[[5, 6]] = "added"
    var tot = 0
    for ((k, v) in m) {
        tot += k[0]
    }
    println("tot={tot}")
    println("has56={m.has([5, 6])}")
    println("miss=" + (m.get([9, 9]) ?? "-"))
}