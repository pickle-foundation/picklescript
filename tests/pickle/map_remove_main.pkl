fn main() {
    let m = {"a": 1, "b": 2}
    let removed = m.remove("a")
    let hasa = m.has("a")
    let hasb = m.has("b")
    let count = len(m.values())
    if (let some(v) = removed) {
        println("removed {v} has-a={hasa} has-b={hasb} count={count}")
    } else {
        println("unexpected none")
    }
    let gone = m.remove("missing") ?? -1
    println("gone {gone}")
}