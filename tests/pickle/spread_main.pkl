fn g(a: int, b: int, c: int) -> int {
    a + b * c
}

fn h(xs: List<int>) -> int {
    g(1, 2, ...xs)
}

fn h2(p: int, xs: List<int>) -> int {
    g(p, ...xs)
}

fn r(n: int) -> List<int> {
    var out = [0]
    out.pop()
    var i = 0
    while (i < n) {
        out.push(i)
        i = i + 1
    }
    out
}

fn main() {
    println(str(h([0])))
    println(str(h2(5, [6, 7])))
    println(str(h2(1, r(2))))
    var q = 0 ..= 3
    var tot = 0
    for (x in q) {
        tot = tot + x
    }
    println("range " + str(tot))
    var half = 0 .. 4
    var tot2 = 0
    for (y in half) {
        tot2 = tot2 + y
    }
    println("half " + str(tot2))
}