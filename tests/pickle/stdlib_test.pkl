test fn abs_ints() {
    expect(abs(5)).toBe(5)
    expect(abs(0)).toBe(0)
    expect(abs(-5)).toBe(5)
}

test fn abs_floats() {
    expect(abs(2.5)).toBe(2.5)
    expect(abs(-2.5)).toBe(2.5)
}

test fn range_simple() {
    let r = range(5)
    expect(len(r)).toBe(5)
    expect(r[0]).toBe(0)
    expect(r[4]).toBe(4)
}

test fn range_bounds() {
    let r = range(2, 5)
    expect(len(r)).toBe(3)
    expect(r[0]).toBe(2)
    expect(r[2]).toBe(4)
}

test fn range_step() {
    let r = range(1, 7, 2)
    expect(len(r)).toBe(3)
    expect(r[0]).toBe(1)
    expect(r[1]).toBe(3)
    expect(r[2]).toBe(5)
}

test fn range_step_negative() {
    let r = range(5, 0, -2)
    expect(len(r)).toBe(3)
    expect(r[0]).toBe(5)
    expect(r[1]).toBe(3)
    expect(r[2]).toBe(1)
}

test fn range_zero_step() {
    let r = range(0, 10, 0)
    expect(len(r)).toBe(0)
}

test fn range_empty() {
    let r = range(10, 0)
    expect(len(r)).toBe(0)
}

test fn for_in_range() {
    var sum = 0
    for (x in range(5)) {
        sum += x
    }
    expect(sum).toBe(10)
}

test fn for_in_range_step() {
    var sum = 0
    for (x in range(1, 10, 2)) {
        sum += x
    }
    expect(sum).toBe(25)
}

test fn min_ints() {
    expect(min(3, 7)).toBe(3)
    expect(min(7, 3)).toBe(3)
    expect(min(-2, 5)).toBe(-2)
    expect(max(3, 7)).toBe(7)
    expect(max(7, 3)).toBe(7)
    expect(max(-2, -5)).toBe(-2)
}

test fn min_floats() {
    expect(min(0.5, 1.5)).toBe(0.5)
    expect(max(0.5, 1.5)).toBe(1.5)
}

test fn clamp_ints() {
    expect(clamp(5, 0, 10)).toBe(5)
    expect(clamp(-3, 0, 10)).toBe(0)
    expect(clamp(42, 0, 10)).toBe(10)
}

test fn clamp_floats() {
    expect(clamp(2.5, 0.0, 1.0)).toBe(1.0)
    expect(clamp(-2.5, 0.0, 1.0)).toBe(0.0)
    expect(clamp(0.5, 0.0, 1.0)).toBe(0.5)
}

test fn str_numbers() {
    expect(str(42)).toBe("42")
    expect(str(-7)).toBe("-7")
    expect(str(2.5)).toBe("2.5")
    expect(str(true)).toBe("true")
}

test fn interp_numbers() {
    let s = "x={42} y={-7} f={2.5}"
    expect(s).toBe("x=42 y=-7 f=2.5")
}

test fn interp_concat_codegen_style() {
    let fn_ = 3
    let id = 7
    let s = "pkl_" + str(fn_) + "_" + str(id)
    expect(s).toBe("pkl_3_7")
}