fn main() {
    let path = "tests/pickle/__fs_main.tmp"
    write_file(path, "main: hello fs")
    let data = read_file(path)
    if (let some(txt) = data) {
        print(txt)
        println("")
    } else {
        println("main: read failed")
    }
    print(file_exists("tests/pickle/fs_test.pkl"))
    println("")
    print(file_exists("tests/pickle/__fs_main_missing.tmp"))
    println("")
    print(read_file("tests/pickle/__fs_main_missing.tmp") ?? "fallback:none")
    println("")
    let dir = "tests/pickle/__fs_main_dir"
    print(mkdir(dir))
    println("")
    print(delete("{dir}/nope.txt"))
    println("")
    write_file("{dir}/x.txt", "x")
    let es = list_dir(dir)
    var n = 0
    if (let some(l) = es) {
        n = len(l)
    }
    print(n)
    println("")
    print(delete("{dir}/x.txt"))
    println("")
    print(delete(dir))
    println("")
    print(delete(path))
    println("")
    print(write_file(path, "regenerated"))
    println("")
}