test fn int_keys_literal_read_and_overwrite() {
    let m = {10: "ten", 20: "twenty"}
    expect(m[10]).toBe("ten")
    expect(m[20]).toBe("twenty")
    m[10] = "TEN"
    expect(m[10]).toBe("TEN")
    expect(len(m)).toBe(2)
}

test fn int_map_index_defaults() {
    let vi = {5: 7}
    expect(vi[9]).toBe(0)
    let vs = {5: "five"}
    expect(vs[9]).toBe("")
}

test fn int_map_methods() {
    let m = {1: "one", 2: "two"}
    expect(m.has(1)).toBe(true)
    expect(m.has(3)).toBe(false)
    if (let some(v) = m.get(1)) {
        expect(v).toBe("one")
    } else {
        expect("unexpected").toBe("int_map_methods: get returned none for a present key")
    }
    let v = m.get(9) ?? "missing"
    expect(v).toBe("missing")
    expect(len(m.keys())).toBe(2)
    expect(len(m.values())).toBe(2)
    if (let some(r) = m.remove(2)) {
        expect(r).toBe("two")
    } else {
        expect("unexpected").toBe("int_map_methods: remove returned none for a present key")
    }
    expect(m.has(2)).toBe(false)
    expect(len(m)).toBe(1)
}

test fn int_keys_iterate_entries() {
    let m = {2: 20, 3: 30, 5: 50}
    var sum_k = 0
    var sum_v = 0
    var n = 0
    for ((k, v) in m) {
        n += 1
        sum_k += k
        sum_v += v
        expect(m[k]).toBe(v)
    }
    expect(n).toBe(3)
    expect(sum_k).toBe(10)
    expect(sum_v).toBe(100)
}

test fn int_keys_iterate_plain_values_and_keys() {
    let m = {4: 40, 6: 60}
    var sum_v = 0
    for (v in m) {
        sum_v += v
    }
    expect(sum_v).toBe(100)
    var sum_k = 0
    for (k in m.keys()) {
        sum_k += k
    }
    expect(sum_k).toBe(10)
}

test fn float_keys() {
    let m = {1.5: "one point five", 2.5: "two point five"}
    expect(m[1.5]).toBe("one point five")
    expect(m.has(2.5)).toBe(true)
    expect(m.has(1.25)).toBe(false)
    m[3.5] = "three point five"
    expect(m[3.5]).toBe("three point five")
    expect(len(m)).toBe(3)
    var sum = 0.0
    for ((k, v) in m) {
        sum += k
        expect(len(v) > 0 || len(v) == 0).toBe(true)
    }
    expect(sum).toBe(7.5)
}

test fn bool_char_keys() {
    let mb = {true: "yes", false: "no"}
    expect(mb[true]).toBe("yes")
    expect(mb[false]).toBe("no")
    expect(mb.has(true)).toBe(true)
    let mc = {'a': 1, 'z': 2}
    expect(mc['a']).toBe(1)
    expect(mc['z']).toBe(2)
    expect(mc.has('m')).toBe(false)
}

test fn byte_keys_from_string_index() {
    let s = "hi"
    let m = {s[0]: "first", s[1]: "second"}
    expect(m[s[0]]).toBe("first")
    expect(m[s[1]]).toBe("second")
    // An in-range int literal is accepted for a byte-keyed look-up.
    expect(m[104]).toBe("first")
    expect(m[105]).toBe("second")
}

test fn large_int_map_grows() {
    var m = {0: "seed"}
    for (i in 1..300) {
        m[i] = "{i} pair"
    }
    expect(len(m)).toBe(300)
    var n = 0
    for ((k, v) in m) {
        if (m[k] == v) {
            n += 1
        }
    }
    expect(n).toBe(300)
}