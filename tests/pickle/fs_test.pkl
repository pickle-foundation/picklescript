test fn fs_write_read_roundtrip() {
    let path = "tests/pickle/__fs_roundtrip.tmp"
    let ok = write_file(path, "hello fs\nsecond line")
    expect(ok).toBe(true)
    let data = read_file(path)
    if (let some(txt) = data) {
        expect(txt).toBe("hello fs\nsecond line")
    } else {
        expect("unexpected").toBe("roundtrip: read_file returned none after a successful write")
    }
}

test fn fs_utf8_bytes_roundtrip() {
    // Non-ASCII text must round-trip byte-exact through the opaque string model.
    let path = "tests/pickle/__fs_utf8.tmp"
    let ok = write_file(path, "h\u{e9}llo \u{2192} done")
    expect(ok).toBe(true)
    let data = read_file(path)
    if (let some(txt) = data) {
        expect(txt).toBe("h\u{e9}llo \u{2192} done")
    } else {
        expect("unexpected").toBe("utf8: read_file returned none after a successful write")
    }
}

test fn fs_read_missing_is_none() {
    let data = read_file("tests/pickle/__fs_does_not_exist.tmp")
    if (let some(_t) = data) {
        expect("unexpected").toBe("missing file read returned some")
    } else {
        expect(true).toBe(true)
    }
}

test fn fs_file_exists() {
    expect(file_exists("tests/pickle/fs_test.pkl")).toBe(true)
    expect(file_exists("tests/pickle/__fs_does_not_exist_2.tmp")).toBe(false)
    expect(file_exists("tests/pickle")).toBe(true)
}

test fn fs_overwrite_existing() {
    let path = "tests/pickle/__fs_overwrite.tmp"
    expect(write_file(path, "first")).toBe(true)
    expect(write_file(path, "second")).toBe(true)
    let data = read_file(path)
    if (let some(txt) = data) {
        expect(txt).toBe("second")
    } else {
        expect("unexpected").toBe("overwrite: read_file returned none after a successful write")
    }
}

test fn fs_match_over_option() {
    let data = read_file("tests/pickle/fs_test.pkl")
    match (data) {
        case some(_t) -> expect(true).toBe(true)
        case none -> expect("unexpected").toBe("match: existing file read as none")
    }
}

test fn fs_delete_removes_and_reports() {
    let path = "tests/pickle/__fs_del.tmp"
    expect(write_file(path, "x")).toBe(true)
    expect(delete(path)).toBe(true)
    expect(file_exists(path)).toBe(false)
    expect(delete(path)).toBe(false)
    expect(delete("tests/pickle/__fs_never_existed.tmp")).toBe(false)
}

test fn fs_list_dir_and_delete_in_dir() {
    let dir = "tests/pickle/__fsdir"
    // Clear a leftover directory from an interrupted prior run so `mkdir`
    // below starts from a clean slate (mkdir fails when the dir exists).
    if (file_exists(dir)) {
        if (let some(prev) = list_dir(dir)) {
            for (p in prev) {
                delete(p)
            }
        }
        delete(dir)
    }
    expect(mkdir(dir)).toBe(true)
    write_file("{dir}/one.txt", "1")
    write_file("{dir}/two.txt", "2")
    let entries = list_dir(dir)
    var n = 0
    var saw_one = false
    var saw_two = false
    if (let some(es) = entries) {
        for (p in es) {
            n += 1
            if (path_contains(p, "one.txt")) {
                saw_one = true
            }
            if (path_contains(p, "two.txt")) {
                saw_two = true
            }
        }
    }
    expect(n).toBe(2)
    expect(saw_one).toBe(true)
    expect(saw_two).toBe(true)
    expect(delete("{dir}/one.txt")).toBe(true)
    expect(delete("{dir}/two.txt")).toBe(true)
    expect(delete(dir)).toBe(true)
}

fn path_contains(s: string, sub: string): bool {
    let sb = bytes(sub)
    let sbl = len(sb)
    if (sbl == 0) {
        return true
    }
    let b = bytes(s)
    var i = 0
    while (i + sbl <= len(b)) {
        var j = 0
        var ok = true
        while (j < sbl) {
            if (b[i + j] != sb[j]) {
                ok = false
            }
            j += 1
        }
        if (ok) {
            return true
        }
        i += 1
    }
    return false
}

test fn fs_list_dir_missing_is_none() {
    let entries = list_dir("tests/pickle/__fs_missing_dir_zz")
    if (let some(_es) = entries) {
        expect("unexpected").toBe("missing dir listed as some")
    } else {
        expect(true).toBe(true)
    }
}

test fn fs_bytes_bridge_read() {
    // `List<byte>` reads compose from the M9 bridge: bytes(read_file(p)).
    let path = "tests/pickle/__fs_bytes.tmp"
    expect(write_file(path, "ab")).toBe(true)
    let data = read_file(path)
    if (let some(txt) = data) {
        let bs = bytes(txt)
        expect(len(bs)).toBe(2)
        expect(bs[0] == 97).toBe(true)
        expect(str(bs)).toBe("ab")
    } else {
        expect("unexpected").toBe("bytes bridge: read_file returned none after a successful write")
    }
}