module std.collections.set_test

import { Set, union, intersect, difference } from std.collections.set

// NOTE: `Set<T>` takes a typed proto value to stage its empty backing list
// (`Set<int>(0)`, `Set<string>("")`) — see the seed's module comment.

test fn empty_set() {
    let s = Set<int>(0)
    expect(s.size()).toBe(0)
    expect(s.contains(1)).toBe(false)
    expect(s.remove(1)).toBe(false)
    expect(len(s.toList())).toBe(0)
}

test fn add_deduplicates() {
    let s = Set<int>(0)
    s.add(1)
    s.add(2)
    s.add(3)
    s.add(2)
    s.add(1)
    expect(s.size()).toBe(3)
    expect(s.contains(1)).toBe(true)
    expect(s.contains(2)).toBe(true)
    expect(s.contains(3)).toBe(true)
    expect(s.contains(4)).toBe(false)
}

test fn remove_middle_first_last() {
    let s = Set<int>(0)
    s.add(10)
    s.add(20)
    s.add(30)
    expect(s.remove(20)).toBe(true)
    expect(s.size()).toBe(2)
    expect(s.contains(20)).toBe(false)
    expect(s.remove(10)).toBe(true)
    expect(s.size()).toBe(1)
    expect(s.remove(30)).toBe(true)
    expect(s.size()).toBe(0)
    expect(s.contains(30)).toBe(false)
}

test fn clear_then_reuse() {
    let s = Set<int>(0)
    s.add(7)
    s.add(8)
    s.clear()
    expect(s.size()).toBe(0)
    expect(s.contains(7)).toBe(false)
    s.add(9)
    expect(s.size()).toBe(1)
    expect(s.contains(9)).toBe(true)
}

test fn to_list_is_a_copy() {
    let s = Set<int>(0)
    s.add(1)
    s.add(2)
    let copy = s.toList()
    copy.push(99)
    expect(s.size()).toBe(2)
    expect(s.contains(99)).toBe(false)
}

test fn string_set() {
    let s = Set<string>("")
    s.add("alpha")
    s.add("beta")
    s.add("alpha")
    expect(s.size()).toBe(2)
    expect(s.contains("beta")).toBe(true)
    expect(s.contains("gamma")).toBe(false)
}

test fn union_intersect_difference() {
    let a = Set<int>(0)
    let b = Set<int>(0)
    a.add(1)
    a.add(2)
    a.add(3)
    b.add(3)
    b.add(4)
    let u = union(a, b)
    expect(u.size()).toBe(4)
    expect(u.contains(1)).toBe(true)
    expect(u.contains(4)).toBe(true)
    let n = intersect(a, b)
    expect(n.size()).toBe(1)
    expect(n.contains(3)).toBe(true)
    expect(n.contains(2)).toBe(false)
    let d = difference(a, b)
    expect(d.size()).toBe(2)
    expect(d.contains(1)).toBe(true)
    expect(d.contains(2)).toBe(true)
    expect(d.contains(3)).toBe(false)
}

test fn ops_on_empty_and_disjoint() {
    let a = Set<int>(0)
    let b = Set<int>(0)
    let u = union(a, b)
    expect(u.size()).toBe(0)
    a.add(1)
    a.add(2)
    b.add(3)
    let n = intersect(a, b)
    expect(n.size()).toBe(0)
    let d = difference(a, b)
    expect(d.size()).toBe(2)
    let u2 = union(a, b)
    expect(u2.size()).toBe(3)
}

test fn proto_consumed_no_ghost() {
    let s = Set<int>(7)
    expect(s.size()).toBe(0)
    expect(s.contains(7)).toBe(false)
    s.add(7)
    expect(s.size()).toBe(1)
    expect(s.contains(7)).toBe(true)
}