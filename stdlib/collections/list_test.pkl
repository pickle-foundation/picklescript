module std.collections.list_test

import { sliceOf, filled, containsElem, indexOfElem } from std.collections.list

test fn slice_copy_positions() {
    let xs = [1, 2, 3, 4, 5]
    let s = sliceOf(xs, 1, 4, 0)
    expect(len(s)).toBe(3)
    expect(s[0]).toBe(2)
    expect(s[1]).toBe(3)
    expect(s[2]).toBe(4)
    xs[1] = 99
    expect(s[0]).toBe(2)
}

test fn slice_clamps_and_empty() {
    let xs = [1, 2, 3, 4, 5]
    expect(len(sliceOf(xs, -3, 2, 0))).toBe(2)
    expect(sliceOf(xs, -3, 2, 0)[0]).toBe(1)
    expect(len(sliceOf(xs, 3, 99, 0))).toBe(2)
    expect(sliceOf(xs, 3, 99, 0)[0]).toBe(4)
    expect(len(sliceOf(xs, 3, 2, 0))).toBe(0)
    expect(len(sliceOf(xs, 0, 0, 0))).toBe(0)
}

test fn slice_strings() {
    let xs = ["a", "bb", "ccc"]
    let s = sliceOf(xs, 1, 3, "")
    expect(len(s)).toBe(2)
    expect(s[0]).toBe("bb")
    expect(s[1]).toBe("ccc")
}

test fn slice_shares_nothing() {
    let a = [10, 20, 30]
    let b = sliceOf(a, 0, 3, 0)
    b[0] = 7
    expect(a[0]).toBe(10)
}

test fn filled_repeats() {
    let f = filled("x", 3)
    expect(len(f)).toBe(3)
    expect(f[0]).toBe("x")
    expect(f[1]).toBe("x")
    expect(f[2]).toBe("x")
    expect(len(filled(0, 0))).toBe(0)
}

test fn membership_scan() {
    let xs = [5, 6, 7]
    expect(containsElem(xs, 6)).toBe(true)
    expect(containsElem(xs, 8)).toBe(false)
    expect(containsElem(["p", "q"], "q")).toBe(true)
    expect(indexOfElem(xs, 7)).toBe(2)
    expect(indexOfElem(xs, 9)).toBe(-1)
    expect(indexOfElem(["p", "q", "p"], "p")).toBe(0)
}