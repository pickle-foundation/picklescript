{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PickleScript",
  "scopeName": "source.picklescript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#function-calls" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.picklescript",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.picklescript",
          "match": "//.*$"
        },
        {
          "name": "comment.block.documentation.picklescript",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/",
          "patterns": [{ "include": "#comments" }]
        },
        {
          "name": "comment.block.picklescript",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [{ "include": "#comments" }]
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.picklescript",
          "match": "#\\[[^\\]]*\\]"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.picklescript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.picklescript",
              "match": "\\{\\{|\\}\\}"
            },
            {
              "name": "constant.character.escape.picklescript",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.picklescript",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [{ "include": "source.picklescript" }]
            }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.picklescript",
          "match": "'(\\\\.|[^'\\\\])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.picklescript",
          "match": "\\b0[xX][0-9a-fA-F_]+[A-Za-z]*\\b"
        },
        {
          "name": "constant.numeric.binary.picklescript",
          "match": "\\b0[bB][01_]+[A-Za-z]*\\b"
        },
        {
          "name": "constant.numeric.octal.picklescript",
          "match": "\\b0[oO][0-7_]+[A-Za-z]*\\b"
        },
        {
          "name": "constant.numeric.float.picklescript",
          "match": "\\b\\d[\\d_]*\\.[\\d_]+(?:[eE][+-]?[\\d_]+)?[A-Za-z]*\\b"
        },
        {
          "name": "constant.numeric.float.picklescript",
          "match": "\\b\\d[\\d_]*[eE][+-]?[\\d_]+[A-Za-z]*\\b"
        },
        {
          "name": "constant.numeric.integer.picklescript",
          "match": "\\b\\d[\\d_]*[A-Za-z]*\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "(\\b(?:class|struct|enum|interface)\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.picklescript" },
            "2": { "name": "entity.name.type.picklescript" }
          }
        },
        {
          "match": "(\\bconstructor\\s*\\.\\s*)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.picklescript" },
            "2": { "name": "entity.name.function.constructor.picklescript" }
          }
        },
        {
          "match": "(\\b(?:fn|constructor|property)\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.picklescript" },
            "2": { "name": "entity.name.function.picklescript" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.picklescript",
          "match": "\\b(?:if|else|while|for|in|break|continue|return|match|case)\\b"
        },
        {
          "name": "keyword.other.picklescript",
          "match": "\\b(?:module|import|use|class|struct|enum|interface|fn|constructor|property|get|set|operator|extends|implements|init|deinit)\\b"
        },
        {
          "name": "storage.modifier.picklescript",
          "match": "\\b(?:static|override|public|private|protected|async|unsafe)\\b"
        },
        {
          "name": "storage.type.picklescript",
          "match": "\\b(?:let|var|const)\\b"
        },
        {
          "name": "variable.language.picklescript",
          "match": "\\b(?:this|super)\\b"
        },
        {
          "name": "constant.language.picklescript",
          "match": "\\b(?:true|false|none)\\b"
        },
        {
          "name": "keyword.operator.word.picklescript",
          "match": "\\b(?:is|as|await|task|channel)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.other.uppercase.picklescript",
          "match": "\\b[A-Z][A-Z0-9_]{2,}\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.picklescript",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)(\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.picklescript" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.picklescript",
          "match": "(?:\\?\\?|\\?\\.|\\?:|=>|->|<-|\\.\\.\\.|\\.\\.=|<<=|>>=|\\.\\.|==|!=|<=|>=|<<|>>|&&|\\|\\||\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|\\*\\*|=|<|>|!|~|\\+|-|\\*|/|%|&|\\||\\^|\\?|@)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.picklescript",
          "match": "::|[\\[\\]{}(),;:]"
        },
        {
          "name": "punctuation.accessor.picklescript",
          "match": "\\."
        }
      ]
    }
  }
}
