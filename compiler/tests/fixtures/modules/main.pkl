import math.ops
import math.ops as mo
import add from math.ops
import helper from text.format as shout
import * from text.format

fn main() {
    let a = math.ops.add(1, 2)
    let b = math.ops.double(3)
    let c = mo.double(4)
    let d = add(2, 3)
    let e = loud("hi")
    let f = shout()
    expect(a).toBe(3)
    expect(b).toBe(6)
    expect(c).toBe(8)
    expect(d).toBe(5)
    expect(e).toBe("hi")
    expect(f).toBe(2)
}